rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /workspaces/{workspaceId} {
      allow read, write: if request.auth != null;

      match /records/{recordId} {
        allow read, write: if request.auth != null;
      }

      match /reports/{reportId} {
        allow read, write: if request.auth != null;
      }

      match /meta/{docId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}