rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function tokenRole() {
      return ('role' in request.auth.token)
        ? request.auth.token.role
        : '';
    }

    function tokenRoleLower() {
      return tokenRole().lower();
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        tokenRoleLower() == 'super_admin' ||
        (('isSuperAdmin' in request.auth.token) && request.auth.token.isSuperAdmin == true) ||
        (('superAdmin' in request.auth.token) && request.auth.token.superAdmin == true)
      );
    }

    function isAdminRole() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        tokenRoleLower() == 'admin' ||
        tokenRole() == 'ADMINISTRADOR'
      );
    }

    function isSupervisorOrAbove() {
      return isAuthenticated() && (
        isAdminRole() ||
        tokenRoleLower() == 'supervisor' ||
        tokenRole() == 'SUPERVISOR'
      );
    }

    function isGerencia() {
      return isAuthenticated() && (
        tokenRoleLower() == 'gerencia' ||
        tokenRole() == 'GERENCIA'
      );
    }

    function canWriteOperational() {
      return isAuthenticated() && !isGerencia();
    }

    // Rol del token normalizado a doc id (legacy → snake_case).
    function roleDocId() {
      return tokenRole() == 'ADMINISTRADOR' ? 'admin'
        : tokenRole() == 'SUPERVISOR' ? 'supervisor'
        : tokenRole() == 'OPERARIO' ? 'operario'
        : tokenRole() == 'GERENCIA' ? 'gerencia'
        : tokenRoleLower();
    }

    function roleDoc() {
      return get(/databases/$(database)/documents/workspaces/vicunha/roles/$(roleDocId()));
    }

    function roleDocExists() {
      return exists(/databases/$(database)/documents/workspaces/vicunha/roles/$(roleDocId()));
    }

    // Deny-by-default: sin doc de rol o inactivo → sin permiso.
    function hasPermission(permission) {
      return isAuthenticated()
        && roleDocExists()
        && roleDoc().data.isActive == true
        && permission in roleDoc().data.permissions;
    }

    // Compatibilidad: si aún no hay roles sembrados, conservar jerarquía legacy.
    function seesWorkspaceRecords() {
      return isSupervisorOrAbove() || isGerencia()
        || (roleDocExists()
          && roleDoc().data.isActive == true
          && roleDoc().data.seesWorkspaceRecords == true);
    }

    function workspaceIdOk(workspaceId) {
      return workspaceId == 'vicunha';
    }

    // ownerUid y createdByUid son inmutables tras el create.
    // Supervisor puede editar campos operativos / borrar, nunca autoría ni dueño.
    function ownershipUnchanged() {
      return request.resource.data.ownerUid == resource.data.ownerUid
        && (
          !('createdByUid' in request.resource.data) ||
          request.resource.data.createdByUid == resource.data.createdByUid
        )
        && !('captureSessionId' in request.resource.data.diff(resource.data).affectedKeys());
    }

    match /workspaces/{workspaceId} {
      allow read: if isAuthenticated() && workspaceIdOk(workspaceId);
      allow create: if isAuthenticated() && workspaceIdOk(workspaceId);
      allow update: if isSupervisorOrAbove() && workspaceIdOk(workspaceId);
      allow delete: if isAdminRole() && workspaceIdOk(workspaceId);

      match /users/{userId} {
        allow read: if isAuthenticated() && workspaceIdOk(workspaceId) && (
          request.auth.uid == userId ||
          seesWorkspaceRecords()
        );

        allow create, delete: if false;

        allow update: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'isActive', 'deletedAt', 'email', 'displayName', 'createdBy',
            'username', 'internalEmail', 'realEmail', 'isSuperAdmin'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastLoginAt', 'fcmToken', 'fcmUpdatedAt'
          ]);

        match /records/{recordId} {
          allow read: if isAuthenticated() && workspaceIdOk(workspaceId) && (
            request.auth.uid == userId ||
            seesWorkspaceRecords()
          );

          allow create: if isAuthenticated()
            && workspaceIdOk(workspaceId)
            && request.auth.uid == userId
            && canWriteOperational()
            && request.resource.data.ownerUid == request.auth.uid
            && (
              !('createdByUid' in request.resource.data) ||
              request.resource.data.createdByUid == request.auth.uid
            );

          allow update: if isAuthenticated()
            && workspaceIdOk(workspaceId)
            && canWriteOperational()
            && (request.auth.uid == userId || isSupervisorOrAbove())
            && ownershipUnchanged();

          allow delete: if isAuthenticated()
            && workspaceIdOk(workspaceId)
            && canWriteOperational()
            && (request.auth.uid == userId || isSupervisorOrAbove());
        }
      }

      match /reports/{reportId} {
        allow read: if isAuthenticated() && workspaceIdOk(workspaceId);
        allow create: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && canWriteOperational()
          && (
            !('createdByUid' in request.resource.data) ||
            request.resource.data.createdByUid == request.auth.uid
          );
        allow update: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && canWriteOperational()
          && (
            !('createdByUid' in request.resource.data.diff(resource.data).affectedKeys()) ||
            request.resource.data.createdByUid == resource.data.createdByUid
          );
        allow delete: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && isSupervisorOrAbove();
      }

      match /meta/fabrics {
        allow read: if isAuthenticated() && workspaceIdOk(workspaceId);
        allow write: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && isSupervisorOrAbove();
      }

      match /meta/config {
        allow read: if isAuthenticated() && workspaceIdOk(workspaceId);
        allow write: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && isAdminRole();
      }

      match /meta/{docId} {
        allow read: if isAuthenticated() && workspaceIdOk(workspaceId);
        allow write: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && isSupervisorOrAbove()
          && docId != 'config';
      }

      match /audit_logs/{logId} {
        allow read: if isSuperAdmin() && workspaceIdOk(workspaceId);
        allow write: if false;
      }

      match /roles/{roleCode} {
        allow read: if isAuthenticated() && workspaceIdOk(workspaceId);
        // super_admin puede sembrar/actualizar roles; el doc super_admin
        // permanece no asignable y de sistema.
        allow create, update: if isSuperAdmin()
          && workspaceIdOk(workspaceId)
          && request.resource.data.code == roleCode
          && (
            roleCode != 'super_admin' ||
            (
              request.resource.data.isAssignable == false &&
              request.resource.data.isSystem == true
            )
          );
        allow delete: if isSuperAdmin()
          && workspaceIdOk(workspaceId)
          && roleCode != 'super_admin'
          && resource.data.isSystem != true;
      }

      match /user_creation_requests/{requestId} {
        allow create: if isSuperAdmin()
          && workspaceIdOk(workspaceId)
          && request.resource.data.type == 'create'
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedByUid == request.auth.uid
          && request.resource.data.username is string
          && request.resource.data.role is string
          && !request.resource.data.keys().hasAny(['password', 'newPassword']);

        allow read: if isSuperAdmin()
          && workspaceIdOk(workspaceId)
          && resource.data.requestedByUid == request.auth.uid;

        allow update, delete: if false;
      }

      match /user_creation_secrets/{requestId} {
        allow create: if isSuperAdmin()
          && workspaceIdOk(workspaceId)
          && request.resource.data.password is string
          && request.resource.data.password.size() >= 8
          && request.resource.data.requestedByUid == request.auth.uid;

        allow read, update, delete: if false;
      }

      match /user_admin_secrets/{requestId} {
        allow create: if isSuperAdmin()
          && workspaceIdOk(workspaceId)
          && request.resource.data.newPassword is string
          && request.resource.data.newPassword.size() >= 8
          && request.resource.data.requestedByUid == request.auth.uid;

        allow read, update, delete: if false;
      }

      match /user_admin_requests/{requestId} {
        allow create: if isSuperAdmin()
          && workspaceIdOk(workspaceId)
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedByUid == request.auth.uid
          && request.resource.data.type in [
            'update', 'disable', 'enable', 'delete', 'resetPassword'
          ]
          && request.resource.data.uid is string
          && !request.resource.data.keys().hasAny(['password', 'newPassword']);

        allow read: if isSuperAdmin()
          && workspaceIdOk(workspaceId)
          && resource.data.requestedByUid == request.auth.uid;

        allow update, delete: if false;
      }

      match /records/{recordId} {
        allow read: if isAuthenticated() && workspaceIdOk(workspaceId);
        allow create: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && canWriteOperational()
          && (
            isSupervisorOrAbove() ||
            request.resource.data.ownerUid == request.auth.uid
          )
          && (
            !('createdByUid' in request.resource.data) ||
            request.resource.data.createdByUid == request.auth.uid
          );
        allow update: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && canWriteOperational()
          && (
            isSupervisorOrAbove() ||
            resource.data.ownerUid == request.auth.uid
          )
          && ownershipUnchanged();
        allow delete: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && canWriteOperational()
          && (
            isSupervisorOrAbove() ||
            resource.data.ownerUid == request.auth.uid
          );
      }
    }
  }
}
