rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function tokenRole() {
      return ('role' in request.auth.token) ? request.auth.token.role : '';
    }

    function tokenRoleLower() {
      return tokenRole().lower();
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        tokenRoleLower() == 'super_admin' ||
        (('isSuperAdmin' in request.auth.token) && request.auth.token.isSuperAdmin == true) ||
        (('superAdmin' in request.auth.token) && request.auth.token.superAdmin == true)
      );
    }

    function roleDocId() {
      return tokenRole() == 'ADMINISTRADOR' ? 'admin'
        : tokenRole() == 'SUPERVISOR' ? 'supervisor'
        : tokenRole() == 'OPERARIO' ? 'operario'
        : tokenRole() == 'GERENCIA' ? 'gerencia'
        : tokenRoleLower();
    }

    function rolePath() {
      return /databases/$(database)/documents/workspaces/vicunha/roles/$(roleDocId());
    }

    function roleExists() {
      return roleDocId() != '' && exists(rolePath());
    }

    function roleData() {
      return get(rolePath()).data;
    }

    function isBaseRole() {
      return roleDocId() in ['super_admin', 'admin', 'supervisor', 'operario', 'gerencia'];
    }

    // Doc remoto activo: SOLO isActive + permissions.
    // Sin doc: fallback legacy SOLO roles base (migración).
    // Rol inactivo con doc: DENY (sin bypass por nombre).
    function hasPermission(permission) {
      return isSuperAdmin()
        || (isAuthenticated() && roleExists()
            && roleData().isActive == true
            && permission in roleData().permissions)
        || (isAuthenticated() && !roleExists() && isBaseRole()
            && legacyHas(permission));
    }

    // Listas compactas para no superar el límite de expresiones.
    function legacyHas(permission) {
      return (roleDocId() == 'operario'
          && permission in ['captureRecords', 'viewRecords'])
        || (roleDocId() == 'supervisor'
          && permission in [
            'viewDashboard', 'viewRecords', 'viewWorkspaceRecords',
            'editRecords', 'viewAlerts', 'applyCorrectiveAction',
            'exportReports', 'manageReports'
          ])
        || (roleDocId() == 'admin'
          && permission in [
            'viewDashboard', 'captureRecords', 'viewRecords',
            'viewWorkspaceRecords', 'editRecords', 'deleteRecords',
            'clearAllRecords', 'viewAlerts', 'applyCorrectiveAction',
            'manageFabrics', 'manageReports', 'exportReports',
            'viewSettings', 'manageSettings'
          ])
        || (roleDocId() == 'gerencia'
          && permission in [
            'viewDashboard', 'viewRecords', 'viewWorkspaceRecords',
            'viewAlerts', 'exportReports', 'manageReports'
          ])
        || (roleDocId() == 'super_admin');
    }

    // Lectura de registros: un solo camino (evita doble hasPermission + límite 1000).
    function canReadRecord(ownerUid) {
      return isSuperAdmin()
        || (isAuthenticated() && roleExists() && roleData().isActive == true && (
          'viewWorkspaceRecords' in roleData().permissions
          || ('viewRecords' in roleData().permissions && request.auth.uid == ownerUid)
        ))
        || (isAuthenticated() && !roleExists() && isBaseRole() && (
          roleDocId() in ['admin', 'supervisor', 'gerencia', 'super_admin']
          || (roleDocId() == 'operario' && request.auth.uid == ownerUid)
        ));
    }

    function canEditRecord(ownerUid) {
      return isSuperAdmin()
        || (isAuthenticated() && roleExists() && roleData().isActive == true
            && 'editRecords' in roleData().permissions
            && (
              'viewWorkspaceRecords' in roleData().permissions
              || request.auth.uid == ownerUid
            ))
        || (isAuthenticated() && !roleExists() && isBaseRole()
            && roleDocId() in ['admin', 'supervisor', 'super_admin']
            && (
              roleDocId() != 'operario'
              || request.auth.uid == ownerUid
            ));
    }

    function canDeleteRecord(ownerUid) {
      return isSuperAdmin()
        || (isAuthenticated() && roleExists() && roleData().isActive == true
            && 'deleteRecords' in roleData().permissions
            && (
              'viewWorkspaceRecords' in roleData().permissions
              || request.auth.uid == ownerUid
            ))
        || (isAuthenticated() && !roleExists() && isBaseRole()
            && roleDocId() in ['admin', 'super_admin']);
    }

    function canCapture() {
      return isSuperAdmin()
        || (isAuthenticated() && roleExists() && roleData().isActive == true
            && 'captureRecords' in roleData().permissions)
        || (isAuthenticated() && !roleExists()
            && roleDocId() in ['admin', 'operario', 'super_admin']);
    }

    function workspaceIdOk(workspaceId) {
      return workspaceId == 'vicunha';
    }

    function ownershipUnchanged() {
      return request.resource.data.ownerUid == resource.data.ownerUid
        && (
          !('createdByUid' in request.resource.data) ||
          request.resource.data.createdByUid == resource.data.createdByUid
        )
        && !('captureSessionId' in request.resource.data.diff(resource.data).affectedKeys());
    }

    function notTombstoned(workspaceId, recordId) {
      return !exists(
        /databases/$(database)/documents/workspaces/$(workspaceId)/record_tombstones/$(recordId)
      );
    }

    function systemRoleCodes() {
      return ['super_admin', 'admin', 'supervisor', 'operario', 'gerencia'];
    }

    match /workspaces/{workspaceId} {
      allow read: if isAuthenticated() && workspaceIdOk(workspaceId);
      allow create: if isSuperAdmin() && workspaceIdOk(workspaceId);
      allow update: if hasPermission('manageSettings') && workspaceIdOk(workspaceId);
      allow delete: if isSuperAdmin() && workspaceIdOk(workspaceId);

      match /users/{userId} {
        allow read: if isAuthenticated() && workspaceIdOk(workspaceId) && (
          request.auth.uid == userId ||
          hasPermission('viewWorkspaceRecords') ||
          hasPermission('manageUsers')
        );

        allow create, delete: if false;

        allow update: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'isActive', 'deletedAt', 'email', 'displayName', 'createdBy',
            'username', 'internalEmail', 'realEmail', 'isSuperAdmin'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastLoginAt', 'fcmToken', 'fcmUpdatedAt'
          ]);

        match /records/{recordId} {
          allow read: if isAuthenticated()
            && workspaceIdOk(workspaceId)
            && canReadRecord(userId);

          allow create: if isAuthenticated()
            && workspaceIdOk(workspaceId)
            && request.auth.uid == userId
            && canCapture()
            && notTombstoned(workspaceId, recordId)
            && request.resource.data.ownerUid == request.auth.uid
            && (
              !('createdByUid' in request.resource.data) ||
              request.resource.data.createdByUid == request.auth.uid
            );

          allow update: if isAuthenticated()
            && workspaceIdOk(workspaceId)
            && canEditRecord(userId)
            && ownershipUnchanged();

          allow delete: if isAuthenticated()
            && workspaceIdOk(workspaceId)
            && canDeleteRecord(userId);
        }
      }

      match /record_tombstones/{recordId} {
        allow read: if isAuthenticated() && workspaceIdOk(workspaceId);

        allow create: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && canDeleteRecord(request.resource.data.ownerUid)
          && request.resource.data.recordId == recordId
          && request.resource.data.deletedByUid == request.auth.uid
          && request.resource.data.keys().hasAll([
            'recordId', 'ownerUid', 'deletedByUid', 'deletedAt'
          ]);

        allow update, delete: if false;
      }

      match /reports/{reportId} {
        allow read: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && (
            hasPermission('manageReports') ||
            hasPermission('exportReports') ||
            hasPermission('viewRecords')
          );
        allow create: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && hasPermission('manageReports')
          && (
            !('createdByUid' in request.resource.data) ||
            request.resource.data.createdByUid == request.auth.uid
          );
        allow update: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && hasPermission('manageReports')
          && (
            !('createdByUid' in request.resource.data.diff(resource.data).affectedKeys()) ||
            request.resource.data.createdByUid == resource.data.createdByUid
          );
        allow delete: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && hasPermission('manageReports');
      }

      match /meta/fabrics {
        allow read: if isAuthenticated() && workspaceIdOk(workspaceId);
        allow write: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && hasPermission('manageFabrics');
      }

      match /meta/config {
        allow read: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && (
            hasPermission('viewSettings') ||
            hasPermission('manageSettings') ||
            hasPermission('editAlertConfig')
          );
        allow write: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && (
            hasPermission('manageSettings') ||
            hasPermission('editAlertConfig')
          );
      }

      match /meta/{docId} {
        allow read: if isAuthenticated() && workspaceIdOk(workspaceId);
        allow write: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && hasPermission('manageSettings')
          && docId != 'config';
      }

      match /audit_logs/{logId} {
        allow read: if isSuperAdmin() && workspaceIdOk(workspaceId);
        allow write: if false;
      }

      match /roles/{roleCode} {
        allow read: if isAuthenticated() && workspaceIdOk(workspaceId);

        allow create: if isSuperAdmin()
          && workspaceIdOk(workspaceId)
          && request.resource.data.code == roleCode
          && (
            (
              request.resource.data.isSystem == false
              && !(roleCode in systemRoleCodes())
            )
            || (
              roleCode in systemRoleCodes()
              && request.resource.data.isSystem == true
              && (
                roleCode != 'super_admin' ||
                (
                  request.resource.data.isAssignable == false &&
                  request.resource.data.isActive == true
                )
              )
            )
          );

        allow update: if isSuperAdmin()
          && workspaceIdOk(workspaceId)
          && request.resource.data.code == roleCode
          && request.resource.data.code == resource.data.code
          && (
            resource.data.isSystem != true ||
            request.resource.data.isSystem == true
          )
          && (
            roleCode != 'super_admin' ||
            (
              request.resource.data.isAssignable == false &&
              request.resource.data.isSystem == true &&
              request.resource.data.isActive == true
            )
          );

        allow delete: if false;
      }

      match /user_creation_requests/{requestId} {
        allow create: if isSuperAdmin()
          && workspaceIdOk(workspaceId)
          && request.resource.data.type == 'create'
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedByUid == request.auth.uid
          && request.resource.data.username is string
          && request.resource.data.role is string
          && !request.resource.data.keys().hasAny(['password', 'newPassword']);

        allow read: if isSuperAdmin()
          && workspaceIdOk(workspaceId)
          && resource.data.requestedByUid == request.auth.uid;

        allow update, delete: if false;
      }

      match /user_creation_secrets/{requestId} {
        allow create: if isSuperAdmin()
          && workspaceIdOk(workspaceId)
          && request.resource.data.password is string
          && request.resource.data.password.size() >= 8
          && request.resource.data.requestedByUid == request.auth.uid;

        allow read, update, delete: if false;
      }

      match /user_admin_secrets/{requestId} {
        allow create: if isSuperAdmin()
          && workspaceIdOk(workspaceId)
          && request.resource.data.newPassword is string
          && request.resource.data.newPassword.size() >= 8
          && request.resource.data.requestedByUid == request.auth.uid;

        allow read, update, delete: if false;
      }

      match /user_admin_requests/{requestId} {
        allow create: if isSuperAdmin()
          && workspaceIdOk(workspaceId)
          && request.resource.data.status == 'pending'
          && request.resource.data.requestedByUid == request.auth.uid
          && request.resource.data.type in [
            'update', 'disable', 'enable', 'delete', 'resetPassword'
          ]
          && request.resource.data.uid is string
          && !request.resource.data.keys().hasAny(['password', 'newPassword']);

        allow read: if isSuperAdmin()
          && workspaceIdOk(workspaceId)
          && resource.data.requestedByUid == request.auth.uid;

        allow update, delete: if false;
      }

      match /records/{recordId} {
        allow read: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && canReadRecord(resource.data.ownerUid);
        allow create: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && canCapture()
          && notTombstoned(workspaceId, recordId)
          && request.resource.data.ownerUid == request.auth.uid
          && (
            !('createdByUid' in request.resource.data) ||
            request.resource.data.createdByUid == request.auth.uid
          );
        allow update: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && canEditRecord(resource.data.ownerUid)
          && ownershipUnchanged();
        allow delete: if isAuthenticated()
          && workspaceIdOk(workspaceId)
          && canDeleteRecord(resource.data.ownerUid);
      }
    }
  }
}
