# =============================================================================
# Calculadora Neps VICUNHA — variables de entorno (referencia)
# =============================================================================
# Copie este archivo como `.env` en la raíz del proyecto si su flujo lo requiere.
# NUNCA suba `.env` ni credenciales reales al repositorio.
#
# La app Flutter usa principalmente `lib/firebase_options.dart` generado con
# FlutterFire CLI. Estas variables son opcionales para scripts, CI o futuras
# configuraciones.
# =============================================================================

# --- Firebase / App (valores ficticios) ---
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:example

# --- Scripts administrativos (Node.js) ---
# Ruta al JSON de service account (solo en máquina local, nunca en git):
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccountKey.json

# --- Configuración opcional de la app ---
APP_ENV=development
ENABLE_DEBUG_LOGS=true

# --- Cloud Functions (functions/.env — ver functions/.gitignore) ---
# Variables específicas del backend se documentan en docs/FIREBASE_ROLES_MIGRATION.md
